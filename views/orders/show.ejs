<%- include('../partials/header') %>
<div class="crumbs"><a href="/orders"><%= t('Заказы') %></a> / #<%= order.id %></div>
<% const act = (action, label, cls = 'btn-ghost', confirm = '') => `<form method="post" action="/orders/${order.id}/${action}"${confirm ? ` data-confirm="${confirm}"` : ''}><input type="hidden" name="_csrf" value="${csrf}"><button class="btn ${cls} btn-sm">${label}</button></form>`; %>
<div class="cols-main">
  <section class="panel">
    <h1><%= t('Заказ #') %><%= order.id %> <span class="order-status os-<%= order.status %>"><%= t(ORDER_STATUS[order.status]) %></span></h1>
    <dl class="dl dl-left">
      <dt><%= t('Канал') %></dt><dd><% if (order.channel_username) { %><a href="/c/<%= order.channel_username %>"><%= order.channel_title %></a><% } else { %><%= order.channel_title %><% } %></dd>
      <dt><%= t('Заказчик') %></dt><dd><a href="/u/<%= customer.id %>"><%= customer.username %></a> <%- include('../partials/user-rating', { u: customer }) %></dd>
      <dt><%= t('Исполнитель') %></dt><dd><a href="/u/<%= executor.id %>"><%= executor.username %></a> <%- include('../partials/user-rating', { u: executor }) %></dd>
      <dt><%= t('Формат') %></dt><dd><%= order.format %></dd>
      <dt><%= t('Цена') %></dt><dd><%= order.price ? h.ads.fmtPrice(order.price, order.currency) : t('договорная') %></dd>
      <dt><%= t('Дата публикации') %></dt><dd><%= order.publish_date || t('по договорённости') %></dd>
      <dt><%= t('Создан') %></dt><dd><%= h.date(order.created_at) %></dd>
    </dl>
    <h3><%= t('Что разместить') %></h3>
    <p class="ad-note"><%= order.note %></p>
    <div class="actions">
      <% if (!isCustomer && order.status === 'new') { %><%- act('accept', t('✅ Принять'), 'btn-primary') %><%- act('decline', t('❌ Отклонить'), 'btn-danger', t('Отклонить заказ?')) %><% } %>
      <% if (!isCustomer && order.status === 'accepted') { %><%- act('done', t('📢 Реклама размещена'), 'btn-primary') %><% } %>
      <% if (isCustomer && order.status === 'done') { %><%- act('complete', t('🏁 Подтвердить выполнение'), 'btn-primary') %><%- act('reopen', t('↩️ Не размещено, вернуть в работу')) %><% } %>
      <% if (isCustomer && order.status === 'accepted') { %><%- act('complete', t('🏁 Заказ выполнен'), 'btn-ghost', t('Подтвердить, что реклама размещена?')) %><% } %>
      <% if (isCustomer && ['new', 'accepted'].includes(order.status)) { %><%- act('cancel', t('Отменить заказ'), 'btn-danger', t('Отменить заказ?')) %><% } %>
      <a class="btn btn-ghost btn-sm" href="/messages/<%= conv.id %>"><%= t('✉️ Переписка') %></a>
    </div>
    <% if (order.status === 'done' && !isCustomer) { %><p class="small muted"><%= t('Ждём, пока заказчик подтвердит размещение.') %></p><% } %>
  </section>
  <aside>
    <section class="panel">
      <h3><%= t('Оценка') %> <%= isCustomer ? t('исполнителя') : t('заказчика') %></h3>
      <% if (order.status !== 'completed') { %>
        <p class="small muted"><%= t('Оценку от 1 до 10 можно поставить после завершения заказа. Из оценок складывается рейтинг пользователей.') %></p>
      <% } else { %>
        <form method="post" action="/orders/<%= order.id %>/rate" class="form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="score-pick"><% for (let i = 1; i <= 10; i++) { %><input type="radio" id="s<%= i %>" name="score" value="<%= i %>" <%= myRating && myRating.score === i ? 'checked' : '' %> required><label for="s<%= i %>"><%= i %></label><% } %></div>
          <label><%= t('Отзыв') %> <small class="muted"><%= t('— необязательно') %></small><textarea name="text" rows="3" maxlength="1000"><%= myRating ? myRating.text : '' %></textarea></label>
          <button class="btn btn-primary btn-sm"><%= myRating ? t('Изменить оценку') : t('Поставить оценку') %></button>
        </form>
        <% if (theirRating) { %><p class="small"><%= t('Вам поставили:') %> <b><%= theirRating.score %>/10</b><% if (theirRating.text) { %> — «<%= theirRating.text %>»<% } %></p><% } %>
      <% } %>
    </section>
  </aside>
</div>
<%- include('../partials/footer') %>
