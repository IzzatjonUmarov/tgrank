<%- include('partials/header') %>
<div class="narrow panel">
  <h1><%= t('Вход') %></h1>
  <% if (config.botUsername && config.botToken) { %>
    <p class="muted"><%= t('Быстрее всего — через Telegram: один клик, без пароля. Так же проще подтвердить владение каналом.') %></p>
    <%- include('partials/tg-login', { next }) %>
    <div class="or"><%= t('или по email') %></div>
  <% } %>
  <% if (error) { %><div class="flash flash-error"><%= t(error) %></div><% } %>
  <form method="post" action="/login" class="form">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>">
    <label>Email<input type="email" name="email" required value="<%= email %>" autocomplete="email"></label>
    <label><%= t('Пароль') %><input type="password" name="password" required autocomplete="current-password"></label>
    <button class="btn btn-primary"><%= t('Войти') %></button>
  </form>
  <p class="muted"><%= t('Нет аккаунта?') %> <a href="/register"><%= t('Зарегистрируйтесь') %></a> <%= t('— это бесплатно.') %></p>
</div>
<%- include('partials/footer') %>
