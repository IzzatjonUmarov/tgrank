<%- include('../partials/header') %>
<section class="panel ch-head">
  <span class="ava ava-lg" style="background:<%= h.avatarColor(profile.username) %>"><%= h.initials(profile.username) %></span>
  <div class="ch-info">
    <h1><%= profile.username %></h1>
    <div class="muted"><%= t('На сайте с {date}', { date: h.date(profile.created_at) }) %><% if (profile.role === 'admin') { %> · <span class="badge"><%= t('администратор') %></span><% } %></div>
    <div class="kpis kpis-sm" style="margin-top:12px">
      <div class="kpi"><span><%= t('Рейтинг') %></span><b><%= profile.rating_count ? profile.rating_avg.toFixed(1) + '/10' : '—' %></b><small><%= profile.rating_count %> <%= t('оценок') %></small></div>
      <div class="kpi"><span><%= t('Выполнил заказов') %></span><b><%= stats.as_executor %></b></div>
      <div class="kpi"><span><%= t('Заказал рекламы') %></span><b><%= stats.as_customer %></b></div>
      <div class="kpi"><span><%= t('Каналов') %></span><b><%= channels.length %></b></div>
    </div>
    <% if (user && user.id !== profile.id) { %><a class="btn btn-primary" href="/messages/with/<%= profile.id %>"><%= t('✉️ Написать') %></a><% } %>
  </div>
</section>
<% if (channels.length) { %>
<section><h2><%= t('Каналы') %></h2><div class="grid"><% channels.forEach((c) => { %><%- include('../partials/card', { c }) %><% }) %></div></section>
<% } %>
<section class="panel">
  <h2><%= t('Оценки ({n})', { n: ratings.length }) %></h2>
  <% if (!ratings.length) { %><p class="muted"><%= t('Оценок пока нет.') %></p><% } %>
  <% ratings.forEach((r) => { %>
    <div class="review"><div><b><%= r.from_name %></b> <span class="urating">⭐ <%= r.score %>/10</span>
      <small class="muted"><%= r.customer_id === profile.id ? t('как заказчику') : t('за размещение') %> · <%= r.format %> <%= t('в «') %><%= r.channel_title %>» · <%= h.date(r.created_at) %></small></div>
      <% if (r.text) { %><p><%= r.text %></p><% } %></div>
  <% }) %>
</section>
<%- include('../partials/footer') %>
