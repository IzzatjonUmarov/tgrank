<%- include('../partials/header') %>
<section class="panel ch-head">
  <span class="ava ava-lg" style="background:<%= h.avatarColor(profile.username) %>"><%= h.initials(profile.username) %></span>
  <div class="ch-info">
    <h1><%= profile.username %></h1>
    <div class="muted">На сайте с <%= h.date(profile.created_at) %><% if (profile.role === 'admin') { %> · <span class="badge">администратор</span><% } %></div>
    <div class="kpis kpis-sm" style="margin-top:12px">
      <div class="kpi"><span>Рейтинг</span><b><%= profile.rating_count ? profile.rating_avg.toFixed(1) + '/10' : '—' %></b><small><%= profile.rating_count %> оценок</small></div>
      <div class="kpi"><span>Выполнил заказов</span><b><%= stats.as_executor %></b></div>
      <div class="kpi"><span>Заказал рекламы</span><b><%= stats.as_customer %></b></div>
      <div class="kpi"><span>Каналов</span><b><%= channels.length %></b></div>
    </div>
    <% if (user && user.id !== profile.id) { %><a class="btn btn-primary" href="/messages/with/<%= profile.id %>">✉️ Написать</a><% } %>
  </div>
</section>
<% if (channels.length) { %>
<section><h2>Каналы</h2><div class="grid"><% channels.forEach((c) => { %><%- include('../partials/card', { c }) %><% }) %></div></section>
<% } %>
<section class="panel">
  <h2>Оценки (<%= ratings.length %>)</h2>
  <% if (!ratings.length) { %><p class="muted">Оценок пока нет.</p><% } %>
  <% ratings.forEach((r) => { %>
    <div class="review"><div><b><%= r.from_name %></b> <span class="urating">⭐ <%= r.score %>/10</span>
      <small class="muted"><%= r.customer_id === profile.id ? 'как заказчику' : 'за размещение' %> · <%= r.format %> в «<%= r.channel_title %>» · <%= h.date(r.created_at) %></small></div>
      <% if (r.text) { %><p><%= r.text %></p><% } %></div>
  <% }) %>
</section>
<%- include('../partials/footer') %>
