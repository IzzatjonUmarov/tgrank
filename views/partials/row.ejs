<a class="row <%= c.boosted ? 'row-boosted' : '' %>" href="/c/<%= c.username %>">
  <% if (typeof pos !== 'undefined') { %><span class="pos"><%= pos %></span><% } %>
  <%- include('avatar', { c }) %>
  <span class="row-main">
    <span class="row-title"><%= c.title %><% if (c.tg_verified) { %> <span title="Верифицирован Telegram" class="tick">✔</span><% } %><% if (c.boosted) { %> <span class="badge boost">🚀 PROMO</span><% } %></span>
    <span class="row-sub muted">@<%= c.username %> · <%= h.TYPES[c.type] %><% if (c.category_name) { %> · <%= c.category_name %><% } %></span>
  </span>
  <span class="row-num"><b><%= h.short(c.subscribers) %></b><small><%- h.delta(c.growth_day) %> / сутки</small></span>
</a>
