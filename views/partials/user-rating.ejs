<% if (u && u.rating_count) { %><span class="urating" title="<%= t('Средняя оценка по {n} завершённым заказам', { n: u.rating_count }) %>">⭐ <%= u.rating_avg.toFixed(1) %>/10 · <%= u.rating_count %></span><% } else { %><span class="urating none" title="<%= t('Пока нет оценок') %>"><%= t('нет оценок') %></span><% } %>
