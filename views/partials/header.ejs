<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> — <%= config.siteName %></title>
<meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Каталог и рейтинг Telegram-каналов, групп и ботов: статистика подписчиков, рост, отзывы и бесплатное продвижение.' %>">
<link rel="stylesheet" href="/style.css">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📊</text></svg>">
</head>
<body>
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="logo" href="/">📊 <%= config.siteName %></a>
    <button class="burger" aria-label="Меню" onclick="document.body.classList.toggle('nav-open')">☰</button>
    <nav class="nav">
      <a href="/channels" class="<%= path === '/channels' ? 'active' : '' %>">Каналы</a>
      <a href="/groups" class="<%= path === '/groups' ? 'active' : '' %>">Группы</a>
      <a href="/bots" class="<%= path === '/bots' ? 'active' : '' %>">Боты</a>
      <a href="/top" class="<%= path === '/top' ? 'active' : '' %>">Рейтинг</a>
      <a href="/pricing" class="<%= path === '/pricing' ? 'active' : '' %>">Тарифы<% if (config.freeMode) { %> <span class="badge free">free</span><% } %></a>
    </nav>
    <form class="search" action="/search" method="get">
      <input name="q" placeholder="Поиск каналов, групп, ботов…" value="<%= query.q || '' %>">
    </form>
    <div class="userbox">
      <a class="btn btn-primary btn-sm" href="/add">+ Добавить</a>
      <% if (user) { %>
        <% if (user.role === 'admin') { %><a class="btn btn-ghost btn-sm" href="/admin">Админка</a><% } %>
        <a class="btn btn-ghost btn-sm" href="/account">👤 <%= user.username %></a>
      <% } else { %>
        <a class="btn btn-ghost btn-sm" href="/login">Войти</a>
      <% } %>
    </div>
  </div>
</header>
<% if (config.freeMode) { %>
<div class="promo-strip">🎉 Этап запуска: все функции, включая продвижение и API, <b>бесплатны</b>.</div>
<% } %>
<main class="wrap">
<% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.text %></div><% } %>
