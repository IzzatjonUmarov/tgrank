<%- include('partials/header') %>
<div class="center-head">
  <h1><%= t('Тарифы') %></h1>
  <p class="muted"><%= t('На этапе запуска') %> <b><%= t('все функции бесплатны') %></b> <%= t('для всех пользователей. Цены ниже — будущие, сейчас вы платите 0.') %></p>
</div>
<% const plans = [
  { name: t('Базовый'), future: '0', items: [t('Добавление каналов, групп и ботов'), t('Статистика и графики подписчиков'), t('Голосование, отзывы, избранное'), t('Подтверждение владения')] },
  { name: t('Продвижение'), future: t('≈ 5 $ / день'), hot: true, items: [t('🚀 Блок «Продвигаемые» на главной'), t('Поднятие вверх каталога и категории'), t('Отметка PROMO в списках'), t('Раз в {cd} ч. на {h} ч.', { cd: config.boostCooldownHours, h: config.boostHours })] },
  { name: 'Pro / API', future: t('≈ 15 $ / мес'), items: [t('Публичный JSON API без ключа'), t('История подписчиков до 365 дней'), t('Бейдж «Мы в рейтинге» для сайта'), t('Приоритетная модерация')] },
]; %>
<div class="plans">
  <% plans.forEach((p) => { %>
  <div class="plan panel <%= p.hot ? 'plan-hot' : '' %>">
    <h2><%= p.name %></h2>
    <div class="price"><% if (config.freeMode) { %><b>0 ₽</b><% if (p.future !== '0') { %><s class="muted"><%= p.future %></s><% } %><% } else { %><b><%= p.future %></b><% } %></div>
    <ul><% p.items.forEach((i) => { %><li>✔ <%= i %></li><% }) %></ul>
    <a class="btn <%= p.hot ? 'btn-accent' : 'btn-primary' %> btn-block" href="/add"><%= config.freeMode ? t('Начать бесплатно') : t('Подключить') %></a>
  </div>
  <% }) %>
</div>
<p class="center muted small"><%= t('Когда появятся платные тарифы, мы заранее предупредим. Всё, что вы сделали бесплатно, останется с вами.') %></p>
<%- include('partials/footer') %>
