<%- include('partials/header') %>
<div class="narrow">
<h1><%= t('Вопросы и ответы') %></h1>
<% [
  [t('Сколько стоит размещение?'), t('Нисколько. На этапе запуска добавление, статистика, продвижение и API бесплатны.')],
  [t('Откуда берутся данные?'), t('Название, описание, аватар и число подписчиков мы получаем с публичной страницы t.me каждые {h} ч. История сохраняется ежедневно — из неё строятся графики и рейтинги роста.', { h: config.statsIntervalHours })],
  [t('Как попасть в «Продвигаемые»?'), t('Подтвердите владение каналом и нажмите «Продвинуть бесплатно» на его странице. Канал будет в блоке на главной и вверху каталога {h} ч. Повторить можно раз в {cd} ч.', { h: config.boostHours, cd: config.boostCooldownHours })],
  [t('Как подтвердить владение?'), t('Быстрее всего — через бота: войдите на сайт через Telegram, добавьте нашего бота в администраторы канала (права можно выключить) и нажмите «Проверить через бота». Или добавьте выданный код в описание канала и нажмите «Проверить код».')],
  [t('Кто может добавлять каналы?'), t('Только владельцы: канал остаётся невидимым черновиком, пока вы не подтвердите владение. Цены на рекламу тоже указывает только подтверждённый владелец.')],
  [t('Как считается место в рейтинге?'), t('По числу подписчиков среди каналов того же типа. Также есть рейтинги по росту за сутки/неделю/месяц, голосам и отзывам.')],
  [t('Что значит «💰 Беру рекламу»?'), t('Владелец канала принимает заказы на рекламу и сам указал форматы, цены и контакт для связи. Договаривайтесь напрямую с владельцем — платформа не берёт комиссию. CPM — цена самого дешёвого формата за 1000 просмотров по среднему охвату поста; по нему удобно сравнивать каналы.')],
  [t('Как начать принимать рекламу?'), t('Подтвердите владение каналом, затем в «Настройках» канала включите «Беру заказы на рекламу», укажите контакт, валюту и прайс. Цены вы задаёте сами и можете менять в любой момент.')],
  [t('Как работает рейтинг пользователей?'), t('После завершённого заказа на рекламу заказчик и владелец канала ставят друг другу оценку от 1 до 10. Рейтинг — средняя из полученных оценок, максимум 10. Оценку можно поставить только по реальному заказу на платформе.')],
  [t('Сколько раз можно голосовать?'), t('Один раз в сутки за каждый канал.')],
  [t('Почему мой канал не одобрили?'), t('Мы не принимаем приватные каналы, мошенничество, 18+ и запрещённый контент. Причина отказа видна на странице канала.')],
].forEach(([q, a]) => { %>
  <details class="panel faq"><summary><%= q %></summary><p><%= a %></p></details>
<% }) %>
</div>
<%- include('partials/footer') %>
