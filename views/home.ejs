<%- include('partials/header') %>
<section class="hero">
  <h1><% if (config.region === 'uz') { %><%= t('🇺🇿 Каталог и рейтинг Telegram-каналов Узбекистана') %><% } else { %><%= t('Каталог и рейтинг Telegram-каналов, групп и ботов') %><% } %></h1>
  <p class="muted"><%= t('Ищите лучшие каналы, следите за ростом подписчиков и охватами, проверяйте на накрутку и продвигайте свой канал — бесплатно. Можно добавить и частный канал.') %></p>
  <form class="hero-search" action="/search">
    <input name="q" placeholder="<%= t('Например: новости, крипта, программирование…') %>" autofocus>
    <select name="type"><option value=""><%= t('Все') %></option><option value="channel"><%= t('Каналы') %></option><option value="group"><%= t('Группы') %></option><option value="bot"><%= t('Боты') %></option></select>
    <button class="btn btn-primary"><%= t('Найти') %></button>
  </form>
  <div class="hero-stats">
    <div><b><%= h.num(stats.channels) %></b><span><%= t('каналов') %></span></div>
    <div><b><%= h.num(stats.groups) %></b><span><%= t('групп') %></span></div>
    <div><b><%= h.num(stats.bots) %></b><span><%= t('ботов') %></span></div>
    <div><b><%= h.short(stats.audience) %></b><span><%= t('суммарная аудитория') %></span></div>
  </div>
</section>

<% if (boosted.length) { %>
<section>
  <div class="section-head"><h2><%= t('🚀 Продвигаемые') %></h2><a href="/pricing"><%= t('Как сюда попасть? — бесплатно') %></a></div>
  <div class="grid"><% boosted.forEach((c) => { %><%- include('partials/card', { c }) %><% }) %></div>
</section>
<% } %>

<div class="cols3">
  <section class="panel"><div class="section-head"><h2><%= t('Топ каналов') %></h2><a href="/top?type=channel"><%= t('Все →') %></a></div>
    <% topChannels.forEach((c, i) => { %><%- include('partials/row', { c, pos: i + 1 }) %><% }) %><% if (!topChannels.length) { %><p class="muted"><%= t('Пока пусто —') %> <a href="/add"><%= t('добавьте первый канал') %></a>.</p><% } %></section>
  <section class="panel"><div class="section-head"><h2><%= t('Топ групп') %></h2><a href="/top?type=group"><%= t('Все →') %></a></div>
    <% topGroups.forEach((c, i) => { %><%- include('partials/row', { c, pos: i + 1 }) %><% }) %><% if (!topGroups.length) { %><p class="muted"><%= t('Пока пусто.') %></p><% } %></section>
  <section class="panel"><div class="section-head"><h2><%= t('Топ ботов') %></h2><a href="/top?type=bot"><%= t('Все →') %></a></div>
    <% topBots.forEach((c, i) => { %><%- include('partials/row', { c, pos: i + 1 }) %><% }) %><% if (!topBots.length) { %><p class="muted"><%= t('Пока пусто.') %></p><% } %></section>
</div>

<section>
  <div class="section-head"><h2><%= t('Категории') %></h2><a href="/catalog"><%= t('Весь каталог →') %></a></div>
  <div class="cats">
    <% categories.forEach((cat) => { %>
      <a class="cat" href="/category/<%= cat.slug %>"><span><%= cat.icon %></span><%= t(cat.name) %><small><%= catCounts[cat.id] || 0 %></small></a>
    <% }) %>
  </div>
</section>

<div class="cols2">
  <section class="panel"><div class="section-head"><h2><%= t('📈 Быстрее всех растут за неделю') %></h2><a href="/top?by=growth_week"><%= t('Все →') %></a></div>
    <% growing.forEach((c, i) => { %><%- include('partials/row', { c, pos: i + 1 }) %><% }) %></section>
  <section class="panel"><div class="section-head"><h2><%= t('🆕 Новые в каталоге') %></h2><a href="/catalog?sort=new"><%= t('Все →') %></a></div>
    <% newest.forEach((c) => { %><%- include('partials/row', { c }) %><% }) %></section>
</div>

<section class="cta">
  <h2><%= t('Есть свой канал, группа или бот?') %></h2>
  <p><%= t('Добавьте его в каталог, подтвердите владение и поднимайте в «Продвигаемые» каждый день — на этапе запуска это бесплатно.') %></p>
  <a class="btn btn-primary" href="/add"><%= t('Добавить бесплатно') %></a>
</section>
<%- include('partials/footer') %>
