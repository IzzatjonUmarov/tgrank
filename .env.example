PORT=3000
BASE_URL=https://your-domain.com
SITE_NAME=TgRank
SESSION_SECRET=замените-на-длинную-случайную-строку
# Этап 1: всё бесплатно. Поставьте false, когда подключите оплату.
FREE_MODE=true
# Email, который при регистрации получит роль администратора.
# Если пусто — админом становится первый зарегистрированный пользователь.
ADMIN_EMAIL=you@example.com
# Необязательно: бот из @BotFather — точный счётчик подписчиков и «Войти через Telegram»
# (в @BotFather выполните /setdomain и укажите ваш домен)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
STATS_INTERVAL_HOURS=6
