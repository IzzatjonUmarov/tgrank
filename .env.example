PORT=3000
BASE_URL=https://your-domain.com
SITE_NAME=TgRank
# Обязателен при https, не короче 32 символов: openssl rand -hex 32
SESSION_SECRET=замените-на-длинную-случайную-строку
# Этап 1: всё бесплатно. Поставьте false, когда подключите оплату.
FREE_MODE=true
# Email, который при регистрации получит роль администратора.
# Если пусто — админом становится первый зарегистрированный пользователь.
ADMIN_EMAIL=you@example.com
# Надёжнее: числовые Telegram ID админов через запятую (виден в личном кабинете после входа через Telegram).
# Если задан, ADMIN_EMAIL игнорируется — email на сайте не подтверждается.
ADMIN_TELEGRAM_IDS=
# Необязательно: бот из @BotFather — точный счётчик подписчиков и «Войти через Telegram»
# (в @BotFather выполните /setdomain и укажите ваш домен)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
STATS_INTERVAL_HOURS=6

# Наполнение базы
# Стартовый список популярных каналов (src/starter-channels.txt)
STARTER_LIST=true
# Автопоиск: добавлять каналы, которые упоминают и репостят каналы из каталога
DISCOVERY=true
DISCOVERY_MIN_SUBSCRIBERS=1000
AUTO_APPROVE_DISCOVERED=true
DISCOVERY_QUEUE_LIMIT=20000
# Сколько страниц истории (по ~20 постов) паук листает у каждого канала
CRAWL_MAX_PAGES=50
# Пауза между запросами к t.me, мс
TME_INTERVAL_MS=1500

# Самопинг /healthz, чтобы бесплатный хостинг не засыпал (нужен https BASE_URL)
KEEP_ALIVE=true
KEEP_ALIVE_MINUTES=10

# Регион каталога: uz — только каналы для узбекского рынка, all — без ограничений
REGION=uz

# Курс для сравнения цен на рекламу в $ и сумах (сортировка, CPM)
USD_UZS=12800
